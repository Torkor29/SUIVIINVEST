# ---------------------------------------------------------------------------
# Configuration SuiviInvest — copiez ce fichier en `.env` puis renseignez les
# valeurs. `.env` ne doit JAMAIS être commité (voir .gitignore).
#   cp .env.example .env && openssl rand -base64 48   # pour la clé maîtresse
# ---------------------------------------------------------------------------

# --- Obligatoire en production -------------------------------------------------
# Clé maîtresse de chiffrement des secrets au repos (jamais en base, jamais en Git).
# Générez-la : openssl rand -base64 48
# ATTENTION : la perdre = perdre définitivement les identifiants des connecteurs.
SUIVIINVEST_MASTER_KEY=

# --- Réseau --------------------------------------------------------------------
SUIVIINVEST_HOST=0.0.0.0
SUIVIINVEST_PORT=9123
# À activer derrière un reverse proxy HTTPS (cookie `Secure`)
SUIVIINVEST_COOKIE_SECURE=true
SUIVIINVEST_TRUST_PROXY=true
# Origines CORS autorisées, séparées par des virgules. Vide = aucune origine
# tierce (recommandé : le frontend est servi par le même serveur).
SUIVIINVEST_CORS_ORIGINS=

# --- Données -------------------------------------------------------------------
SUIVIINVEST_DB=/data/suiviinvest.db
SUIVIINVEST_BACKUP_DIR=/backups
SUIVIINVEST_WEB_DIR=/app/web
SUIVIINVEST_BASE_CURRENCY=EUR
SUIVIINVEST_SESSION_TTL_MINUTES=720
SUIVIINVEST_LOG_LEVEL=info

# --- Ordonnanceur --------------------------------------------------------------
# Synchronisations automatiques (tous les jours à 6 h) et sauvegardes (3 h 30).
SUIVIINVEST_SCHEDULER_ENABLED=true
SUIVIINVEST_SCHEDULER_CRON=0 6 * * *
SUIVIINVEST_BACKUP_CRON=30 3 * * *
SUIVIINVEST_BACKUP_RETENTION_DAYS=30

# --- Fournisseurs de données de marché ----------------------------------------
# Ordre de préférence ; le premier qui répond gagne (repli automatique).
SUIVIINVEST_MARKET_PROVIDERS=yahoo,coingecko,ecb

# --- Secrets des connecteurs ---------------------------------------------------
# ⚠️ À NE PAS METTRE ICI. Les identifiants (DEGIRO, Trade Republic, Crédit
# Agricole...) se saisissent depuis l'interface, dans Connexions : ils sont
# chiffrés (AES-256-GCM) dans la base et ne passent jamais par un fichier.
#
# Rappels non négociables :
#   - aucune seed phrase ni clé privée n'est acceptée, ni ici ni ailleurs ;
#   - un wallet se suit par adresse publique ;
#   - l'application est STRICTEMENT en lecture seule (aucun ordre, aucun virement).
